# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Newsletter signup (src/app/api/newsletter/route.ts)
GOOGLE_SHEETS_API_URL=

# Certificate validator (src/app/api/certificates/route.ts)
CERTIFICATE_DATA=

# Student Help Desk, PYQ tool (src/lib/imagekit-papers.ts). Server-side only.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PYQ_FOLDER=/PYQs